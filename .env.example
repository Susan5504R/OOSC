# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Comma-separated. Two keys from two Google accounts = two separate free-tier quota pools.
GEMINI_API_KEYS=key_one_here,key_two_here

# Agents-under-test run on the cheapest model on purpose: we WANT failures, and it is
# easier on the daily quota.
CRUCIBLE_AGENT_MODEL=gemini-3.5-flash-lite

# Self-imposed daily cap. The runner hard-stops here so a bad loop can't burn the day's
# quota. Free-tier RPD is the thing that kills this project.
CRUCIBLE_DAILY_CALL_BUDGET=150
